# Copy to .env and fill in. `docker compose up` reads .env automatically.

# Required. Create a key at https://openrouter.ai/keys
# The backend refuses to start without it (or with this placeholder).
# `make dev` runs the backend outside Docker and does not read this file:
# export OPENROUTER_API_KEY in your shell for that.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional model overrides (defaults live in backend/crates/ai/models.toml)
# AI_INTAKE_MODEL=openai/gpt-6-luna
# AI_INTAKE_EFFORT=low
# AI_RESPONDER_MODEL=openai/gpt-6-luna
# AI_RESPONDER_EFFORT=none
# AI_REVIEW_MODEL=openai/gpt-6-luna-pro
# AI_REVIEW_EFFORT=medium
# AI_NOTICE_MODEL=openai/gpt-6-luna
# AI_NOTICE_EFFORT=low
# AI_FALLBACK_MODEL=openai/gpt-5.6-luna

# Optional logging filter for the backend
# RUST_LOG=info,sqlx=warn
